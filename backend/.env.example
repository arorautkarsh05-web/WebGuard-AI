# WebGuard AI - Production Configuration Template

# Runtime Environment (development | production | testing)
ENVIRONMENT=development

# JWT Security
# CRITICAL: In production, SECRET_KEY must be a cryptographically secure string (min 32 chars)
SECRET_KEY=generate_a_cryptographically_secure_random_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Production: postgresql://username:password@hostname:5432/webguard_db
# Local Dev / Testing: sqlite:///./webguard.db
DATABASE_URL=sqlite:///./webguard.db

# TinyFish Agent, Search, & Fetch APIs
# Get your key at: https://www.tinyfish.ai/
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_AGENT_URL=https://agent.tinyfish.ai

# Background Task Scheduler
ENABLE_BACKGROUND_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=30
REDIS_URL=redis://localhost:6379/0

# Optional Demo Administrator (Development Only - Never Provisioned in Production)
DEFAULT_ADMIN_EMAIL=admin@webguard.ai
DEFAULT_ADMIN_PASSWORD=WebGuardPass2026!
